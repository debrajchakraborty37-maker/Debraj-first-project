# Copy to .env (never commit .env). Real values go in your host's secret settings in production.

NODE_ENV=production
PORT=8080

# Long random string, at least 32 characters: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=12h

# Admin sign-in. Store only the HASH, never the password:  cd server && npm run hash
ADMIN_EMAIL=debraj.c@theebg.com
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Debraj C

# The Google Sheet that is the database (the long id in its URL)
STORE=google
SHEET_ID=1nlnxzk2sFn5vC81XJp6-oej9OU1ZhSL9wVRVTZeSycs
# Service account JSON key, raw or base64. The sheet must be shared with that account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Programmable Search (for finding leads and agencies). Billed per query; see monthlyQueryCap in the app.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Only needed if you serve the Flutter web build from another address
CORS_ORIGINS=
